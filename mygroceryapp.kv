## Rule for popup  clearing the the current list and moving list to one place back 

<MyClearListPopup>:
    
    id : clear_list_id
    
    ##size_hint :( .8, .2)
    size_hint : None, None
    size : (dp(300), dp(150))
    title: ""
    separator_height: dp(0)
    title_size : dp(0)
    
    background: ""
    background_color:0,0,0,0
    
    content: 
    BoxLayout:
        orientation : 'vertical'
        ##size_hint : (1,1)
        

        BoxLayout : 
            orientation : 'vertical'
            ##size_hint : (1,.6)
            size_hint : None, None
            size : (dp(300), dp(50))
            
            canvas.before :
                Color :
                    rgba : .372, .619, .627,1
                RoundedRectangle :
                    size : self.size
                    pos : self.pos
                    radius : [dp(20),dp(20),dp(0),dp(0)]
                Color :
                    rgba :.372, .619, .627,1
                Line :
                    width : dp(1)
                    rounded_rectangle : self.x, self.y, self.width, self.height ,dp(20),dp(20),dp(0),dp(0)

            Label :
                text : 'This will clear the current list! Move the lists one place back.'
                valign : 'center'
                halign : 'left'
                color : 1,1,1,1
               
                padding : dp(16)
                ##shorten : True
                text_size: self.width, None
                font_size : '12sp'
        BoxLayout : 
            orientation : 'horizontal'
            ##size_hint : (1,.4)
            size_hint : None, None
            size : (dp(300), dp(50))
            padding : [dp(32),dp(8),dp(32),dp(8)]
            canvas.before :
                Color :
                    rgba : .372, .619, .627,1
                RoundedRectangle :
                    size : self.size
                    pos : self.pos
                    radius : [dp(0),dp(0),dp(20),dp(20)]
                Color :
                    rgba :.372, .619, .627,1
                Line :
                    width : dp(1)
                    rounded_rectangle : self.x, self.y, self.width, self.height ,dp(0),dp(0),dp(20),dp(20)
            
            MyLabel :
                text : 'Ok...'
                text_size : self.size
                font_size : '14sp'
                valign : 'center'
                halign : 'center'
                on_touch_down:   if self.collide_point(*args[1].pos): app.root.select_all_items()
            MyLabel :
                text : 'Cancel!'
                text_size : self.size
                font_size : '14sp'
                valign : 'center'
                halign : 'center'
                on_touch_down:   if self.collide_point(*args[1].pos):app.root.cancel_clear_list_popup()        
